{
  "$defs": {
    "ReconciliationVerdict": {
      "description": "What the takeover agent concluded about the effort's recorded state.",
      "enum": [
        "clean"
      ],
      "title": "ReconciliationVerdict",
      "type": "string"
    },
    "Telemetry": {
      "additionalProperties": false,
      "description": "Read off the session's `result` event \u2014 the same event that means stale.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "is_error": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Error"
        },
        "model_usage": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Usage"
        },
        "num_turns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Turns"
        },
        "permission_denials": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission Denials"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Reason"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage"
        }
      },
      "title": "Telemetry",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "One harness-tool call, and whether it took effect.\n\nA refused call is recorded rather than dropped: what the agent tried to do\nand was not allowed to is the interesting half of a surprising decision.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "refused": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the tool layer refused it, or None when it took effect.",
          "title": "Refused"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`reconciliations/<reconciliation-id>.json`.\n\nOne per takeover consultation. Written before the agent runs \u2014 so a slow\njudgment is visible while it is being made \u2014 and rewritten once it ends.",
  "properties": {
    "effort": {
      "description": "The effort directory name under `.scratch/`.",
      "title": "Effort",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "examined": {
      "description": "One line per thing examined \u2014 gathered deterministically by the harness before the agent was consulted, never by the agent.",
      "items": {
        "type": "string"
      },
      "title": "Examined",
      "type": "array"
    },
    "model": {
      "description": "The model the consultation ran on.",
      "title": "Model",
      "type": "string"
    },
    "prose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the agent said. Recorded for the reader; it has no effect on any state.",
      "title": "Prose"
    },
    "reconciliation_id": {
      "description": "`<sequence>-<effort>`, so the directory sorts chronologically.",
      "title": "Reconciliation Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "description": "Run-wide, continued across takeovers.",
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "description": "The ephemeral agent's own session id.",
      "title": "Session Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "telemetry": {
      "$ref": "#/$defs/Telemetry"
    },
    "tool_calls": {
      "description": "Everything the consultation actually did, refusals included.",
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReconciliationVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The verdict the agent landed as a tool call, or None when it landed none \u2014 in which case the takeover stopped instead of resuming."
    }
  },
  "required": [
    "reconciliation_id",
    "sequence",
    "effort",
    "examined",
    "model",
    "session_id",
    "started_at"
  ],
  "title": "ReconciliationRecord",
  "type": "object"
}
