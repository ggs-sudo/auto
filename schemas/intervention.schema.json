{
  "$defs": {
    "InterventionTrigger": {
      "description": "What caused a fresh agent to be invoked.\n\nEvery judgment happens at a stale point today. A gate response is the same\nprimitive under a different trigger, and joins this enum with gates.",
      "enum": [
        "stale"
      ],
      "title": "InterventionTrigger",
      "type": "string"
    },
    "Telemetry": {
      "additionalProperties": false,
      "description": "Read off the session's `result` event \u2014 the same event that means stale.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "is_error": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Error"
        },
        "model_usage": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Usage"
        },
        "num_turns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Turns"
        },
        "permission_denials": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission Denials"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "terminal_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Reason"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage"
        }
      },
      "title": "Telemetry",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "One harness-tool call, and whether it took effect.\n\nA refused call is recorded rather than dropped: what the agent tried to do\nand was not allowed to is the interesting half of a surprising decision.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "refused": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the tool layer refused it, or None when it took effect.",
          "title": "Refused"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`interventions/<intervention-id>.json`.\n\nOne per invocation, never one per run: the agent is ephemeral, so this file\nis the only place its reasoning survives.",
  "properties": {
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "intervention_id": {
      "description": "`<sequence>-<node>`, so the directory sorts chronologically.",
      "title": "Intervention Id",
      "type": "string"
    },
    "model": {
      "description": "Pinned in configuration, recorded here, never inherited from the user's editor config.",
      "title": "Model",
      "type": "string"
    },
    "node": {
      "description": "The single node this invocation could act on.",
      "title": "Node",
      "type": "string"
    },
    "prose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the agent said. Recorded for the reader; it has no effect on any state.",
      "title": "Prose"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "description": "The ephemeral agent's own session id.",
      "title": "Session Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "telemetry": {
      "$ref": "#/$defs/Telemetry"
    },
    "tool_calls": {
      "description": "Everything the invocation actually did. An empty list is valid and means the node is still working.",
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "trigger": {
      "$ref": "#/$defs/InterventionTrigger"
    }
  },
  "required": [
    "intervention_id",
    "node",
    "trigger",
    "model",
    "session_id",
    "started_at"
  ],
  "title": "InterventionRecord",
  "type": "object"
}
